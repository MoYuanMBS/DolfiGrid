# 1. 默认对所有文本文件强制使用 LF 换行符
* text=auto eol=lf

# 2. 显式声明常用的代码与文本文件（确保不会被误判）
*.js        text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
.gitignore  text eol=lf

# 3. 显式声明二进制文件（绝对不修改换行符，防止文件损坏）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary